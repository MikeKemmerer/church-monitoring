#!/usr/bin/env bash
# church-monitoring-activate-evergreen-image — Moves a calendar image from
# the images/evergreen/ reserve pool back into the live images/ folder
# (putting it back into rotation) and regenerates optimized/thumbnail
# derivatives.
#
# Must run as the church-calendar owner (invoked via `sudo -u pi` by
# activate-evergreen-image.cgi).
#
# Usage: church-monitoring-activate-evergreen-image <images_dir> <filename>
#            [--mode persistent|scheduled] [--show-from YYYY-MM-DD]
#            [--remove-after YYYY-MM-DD] [--auto-archive]
# An activated image always starts with the dates chosen here, never its old ones.
set -euo pipefail

IMAGES_DIR="${1:?images_dir required}"
FILENAME="${2:?filename required}"
shift 2
MODE=""
SHOW_FROM=""
REMOVE_AFTER=""
AUTO_ARCHIVE=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --mode) MODE="${2:-}"; shift 2 ;;
        --show-from) SHOW_FROM="${2:-}"; shift 2 ;;
        --remove-after) REMOVE_AFTER="${2:-}"; shift 2 ;;
        --auto-archive) AUTO_ARCHIVE=1; shift ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done
if [[ -n "$MODE" && "$MODE" != "persistent" && "$MODE" != "scheduled" ]]; then
    echo "--mode must be persistent or scheduled" >&2
    exit 1
fi
for day in "$SHOW_FROM" "$REMOVE_AFTER"; do
    if [[ -n "$day" && ! "$day" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        echo "Dates must be YYYY-MM-DD" >&2
        exit 1
    fi
done

if [[ "$(basename "$FILENAME")" != "$FILENAME" ]]; then
    echo "Invalid filename" >&2
    exit 1
fi

if [[ ! -d "$IMAGES_DIR" ]]; then
    echo "images_dir does not exist: $IMAGES_DIR" >&2
    exit 1
fi

# One lock shared with church-calendar's own schedule sweep, so the move and the
# schedule entry change together and the calendar never sees one without the other.
# Taken before the checks below so an upload cannot slip in between check and move.
exec 9>>"$IMAGES_DIR/.image-schedule.lock"
flock -w 30 9 || { echo "Timed out waiting for the image schedule lock" >&2; exit 1; }
export IMAGE_SCHEDULE_LOCK_HELD=1

EVERGREEN_DIR="$IMAGES_DIR/evergreen"
SOURCE="$EVERGREEN_DIR/$FILENAME"
if [[ ! -f "$SOURCE" ]]; then
    echo "Evergreen image not found: $SOURCE" >&2
    exit 1
fi

TARGET="$IMAGES_DIR/$FILENAME"
if [[ -e "$TARGET" ]]; then
    echo "A file already exists at $TARGET; refusing to overwrite" >&2
    exit 1
fi

mv -n "$SOURCE" "$TARGET"

CALENDAR_ROOT="$(dirname "$IMAGES_DIR")"
if [[ -n "$MODE" ]]; then
    SCHEDULER="$CALENDAR_ROOT/image_schedule.py"
    ARGS=(--images-dir "$IMAGES_DIR" set "$FILENAME")
    if [[ "$MODE" == "persistent" ]]; then
        ARGS+=(--persistent)
    else
        [[ -z "$SHOW_FROM" ]] || ARGS+=(--show-from "$SHOW_FROM")
        [[ -z "$REMOVE_AFTER" ]] || ARGS+=(--remove-after "$REMOVE_AFTER")
        [[ "$AUTO_ARCHIVE" -eq 0 ]] || ARGS+=(--auto-archive)
    fi
    if [[ ! -f "$SCHEDULER" ]] || ! python3 "$SCHEDULER" "${ARGS[@]}" >/dev/null; then
        mv "$TARGET" "$SOURCE"
        echo "Could not apply the image schedule (is church-calendar up to date?); image left in evergreen" >&2
        exit 1
    fi
fi
if [[ -f "$CALENDAR_ROOT/image_optimizer.py" ]]; then
    ( cd "$CALENDAR_ROOT" && python3 image_optimizer.py ) || echo "Warning: optimizer run failed" >&2
fi

echo "Activated $SOURCE -> $TARGET"
