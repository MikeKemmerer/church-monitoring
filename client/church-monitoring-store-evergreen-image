#!/usr/bin/env bash
# church-monitoring-store-evergreen-image — Moves an active calendar image
# into the images/evergreen/ subfolder (a reusable reserve pool, distinct
# from images/archive/'s "retired" images) and regenerates optimized/
# thumbnail derivatives, which removes the now-orphaned ones via
# church-calendar's own cleanup logic. The stored file is preserved and can
# be brought back into rotation later (see
# church-monitoring-activate-evergreen-image).
#
# Must run as the church-calendar owner (invoked via `sudo -u pi` by
# store-evergreen-image.cgi).
#
# Usage: church-monitoring-store-evergreen-image <images_dir> <filename>
set -euo pipefail

IMAGES_DIR="${1:?images_dir required}"
FILENAME="${2:?filename required}"

if [[ "$(basename "$FILENAME")" != "$FILENAME" ]]; then
    echo "Invalid filename" >&2
    exit 1
fi

if [[ ! -d "$IMAGES_DIR" ]]; then
    echo "images_dir does not exist: $IMAGES_DIR" >&2
    exit 1
fi

# Shared with church-calendar's own schedule sweep (see write-calendar-image); taken first so
# the existence check below cannot go stale before the move.
exec 9>>"$IMAGES_DIR/.image-schedule.lock"
flock -w 10 9 || { echo "Timed out waiting for the image schedule lock" >&2; exit 1; }

TARGET="$IMAGES_DIR/$FILENAME"
if [[ ! -f "$TARGET" ]]; then
    echo "Image not found: $TARGET" >&2
    exit 1
fi

# A name already in evergreen gets _1, _2 ... before any ' [auto-archive]' marker and the extension.
unique_destination() {
    local dir="$1" name="$2" stem ext="" marker="" n=1
    if [[ ! -e "$dir/$name" ]]; then
        printf '%s' "$dir/$name"
        return
    fi
    stem="$name"
    if [[ "$name" == *.* ]]; then
        ext=".${name##*.}"
        stem="${name%.*}"
    fi
    if [[ "${stem,,}" == *" [auto-archive]" ]]; then
        marker="${stem: -15}"
        stem="${stem:0:${#stem}-15}"
    fi
    while [[ -e "$dir/${stem}_${n}${marker}${ext}" ]]; do
        n=$((n + 1))
    done
    printf '%s' "$dir/${stem}_${n}${marker}${ext}"
}

EVERGREEN_DIR="$IMAGES_DIR/evergreen"
mkdir -p "$EVERGREEN_DIR"
DESTINATION="$(unique_destination "$EVERGREEN_DIR" "$FILENAME")"
mv -n "$TARGET" "$DESTINATION"

# church-calendar's code folder: client-config "calendar_app_path", else the calendar service's
# WorkingDirectory, else the parent of the images folder. They differ when images live on a share.
find_calendar_root() {
    local images_dir="$1" candidate
    local cfg="${CLIENT_CONFIG:-/etc/church-monitoring/client-config.json}"
    for candidate in \
        "$(jq -r '.calendar_app_path // empty' "$cfg" 2>/dev/null || true)" \
        "$(systemctl show "${CALENDAR_SERVICE:-church-calendar.service}" -p WorkingDirectory --value 2>/dev/null || true)" \
        "$(dirname "$images_dir")"; do
        if [[ -n "$candidate" && ( -f "$candidate/image_schedule.py" || -f "$candidate/image_optimizer.py" ) ]]; then
            printf '%s' "$candidate"
            return
        fi
    done
    printf '%s' "$(dirname "$images_dir")"
}
CALENDAR_ROOT="$(find_calendar_root "$IMAGES_DIR")"
if [[ -f "$CALENDAR_ROOT/image_optimizer.py" ]]; then
    ( cd "$CALENDAR_ROOT" && python3 image_optimizer.py --images-dir "$IMAGES_DIR" ) || echo "Warning: optimizer run failed" >&2
fi

echo "Stored $TARGET -> $DESTINATION"
