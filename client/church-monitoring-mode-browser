#!/usr/bin/env bash
# church-monitoring-mode-browser - Switches to the browser by killing VLC only.
# Keeps videokiosk2 service running so vlc-wrapper can manage failover.
# Must be run as root (called via sudo by mode-switch.cgi).

# Kill any running VLC process. The wrapper should detect exit and launch its browser failover.
if pkill -f "^vlc" 2>/dev/null; then
    echo "VLC terminated; waiting for videokiosk2 wrapper to fail over to its browser"
else
    echo "No running VLC process found"
fi
