{
    "hostname": "my-server",
    "cert_path": "/etc/church-monitoring/ssl/agent.crt",
    "slow_metric_ttl_seconds": {
        "cert_expiry": 43200,
        "tailscale_key_expiry": 43200,
        "apt": 43200,
        "firmware_age": 86400
    },
    "monitors": [
        {"name": "apache2", "type": "systemd"},
        {"name": "church-calendar", "type": "systemd"},
        {"name": "videokiosk2", "type": "systemd"},
        {"name": "vlc", "type": "process", "match": "vlc -f http://server:8080/stream"},
        {"name": "midori", "type": "process", "match": "midori|x-www-browser"}
    ],
    "cec_enabled": false
}
