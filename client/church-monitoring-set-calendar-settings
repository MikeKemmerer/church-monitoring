#!/usr/bin/env bash
# church-monitoring-set-calendar-settings — Pushes church-calendar display
# settings (theme, font, slide speed, margins) to the kiosk browser session.
#
# Usage: church-monitoring-set-calendar-settings <theme> <font> <speed> <margins>
# Each argument is either an allow-listed value or "-" to leave it unchanged.
set -euo pipefail

KIOSK_SERVICE="${KIOSK_SERVICE:-videokiosk2.service}"
KIOSK_CONFIG="${VIDEOKIOSK2_CONFIG:-/etc/videokiosk2/local.conf}"
KIOSK_DISPLAY="${KIOSK_DISPLAY:-:0}"
FAILOVER_LOG="${FAILOVER_LOG:-/tmp/videokiosk2-failover.log}"

ALLOWED_THEMES=(classic-gold modern-blue elegant-black liturgical-purple festive-red light)
ALLOWED_FONTS=(cinzel-lora roboto-open-sans playfair-source)
ALLOWED_SPEEDS=(12 18)

THEME="${1:--}"
FONT="${2:--}"
SPEED="${3:--}"
MARGINS="${4:--}"

in_list() {
    local needle="$1"
    shift
    local item
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

QS=""
add_param() {
    local key="$1" val="$2"
    if [[ -n "$QS" ]]; then
        QS="${QS}&${key}=${val}"
    else
        QS="${key}=${val}"
    fi
}

if [[ "$THEME" != "-" ]]; then
    if ! in_list "$THEME" "${ALLOWED_THEMES[@]}"; then
        echo "Invalid theme: $THEME" >&2
        exit 1
    fi
    add_param "theme" "$THEME"
fi

if [[ "$FONT" != "-" ]]; then
    if ! in_list "$FONT" "${ALLOWED_FONTS[@]}"; then
        echo "Invalid font: $FONT" >&2
        exit 1
    fi
    add_param "font" "$FONT"
fi

if [[ "$SPEED" != "-" ]]; then
    if ! in_list "$SPEED" "${ALLOWED_SPEEDS[@]}"; then
        echo "Invalid speed: $SPEED" >&2
        exit 1
    fi
    add_param "speed" "$SPEED"
fi

if [[ "$MARGINS" != "-" ]]; then
    if [[ "$MARGINS" != "0" && "$MARGINS" != "1" ]]; then
        echo "Invalid margins: $MARGINS" >&2
        exit 1
    fi
    add_param "margins" "$MARGINS"
fi

if [[ -z "$QS" ]]; then
    echo "No valid settings provided" >&2
    exit 1
fi

KIOSK_USER=$(systemctl show "$KIOSK_SERVICE" -p User --value 2>/dev/null || true)
if [[ -z "$KIOSK_USER" ]]; then
    echo "Unable to determine the kiosk user from $KIOSK_SERVICE" >&2
    exit 1
fi

KIOSK_HOME=$(getent passwd "$KIOSK_USER" | cut -d: -f6)
if [[ -z "$KIOSK_HOME" || ! -d "$KIOSK_HOME" ]]; then
    echo "Kiosk user home directory is unavailable: $KIOSK_USER" >&2
    exit 1
fi

if [[ ! -f "$KIOSK_CONFIG" && -f "$KIOSK_HOME/local.conf" ]]; then
    KIOSK_CONFIG="$KIOSK_HOME/local.conf"
fi
if [[ -f "$KIOSK_CONFIG" ]]; then
    # shellcheck source=/dev/null
    source "$KIOSK_CONFIG"
fi
if [[ -z "${BROWSER_URL:-}" ]]; then
    echo "BROWSER_URL not configured in $KIOSK_CONFIG" >&2
    exit 1
fi

KIOSK_UID=$(id -u "$KIOSK_USER")
KIOSK_RUNTIME_DIR="/run/user/$KIOSK_UID"
KIOSK_ENV=(
    "HOME=$KIOSK_HOME"
    "DISPLAY=$KIOSK_DISPLAY"
    "XDG_RUNTIME_DIR=$KIOSK_RUNTIME_DIR"
)
if [[ -S "$KIOSK_RUNTIME_DIR/bus" ]]; then
    KIOSK_ENV+=("DBUS_SESSION_BUS_ADDRESS=unix:path=$KIOSK_RUNTIME_DIR/bus")
fi

resolve_xauthority() {
    local candidate
    local -a candidates=("$KIOSK_HOME/.Xauthority")

    while IFS= read -r -d '' candidate; do
        candidates+=("$candidate")
    done < <(
        find "$KIOSK_RUNTIME_DIR" "$KIOSK_HOME" -maxdepth 3 -type f \
            \( -name '.Xauthority' -o -name 'Xauthority' -o -name '.mutter-Xwaylandauth.*' \) \
            -print0 2>/dev/null
    )

    for candidate in "${candidates[@]}"; do
        if [[ -r "$candidate" ]] && runuser -u "$KIOSK_USER" -- env \
            "${KIOSK_ENV[@]}" XAUTHORITY="$candidate" xset q >/dev/null 2>&1; then
            KIOSK_ENV+=("XAUTHORITY=$candidate")
            return
        fi
    done

    echo "Unable to find X11 authorization for $KIOSK_USER on $KIOSK_DISPLAY" >&2
    exit 1
}

detect_failover_browser() {
    if [[ -n "${FAILOVER_BROWSER:-}" ]]; then
        case "$FAILOVER_BROWSER" in
            falkon|midori) return ;;
            *) echo "Unsupported FAILOVER_BROWSER: $FAILOVER_BROWSER" >&2; exit 1 ;;
        esac
    fi

    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        source /etc/os-release
        if [[ "${ID:-}" == "raspbian" || "${ID_LIKE:-}" == *raspbian* || \
            "${NAME:-}" == *"Raspberry Pi OS"* || "${PRETTY_NAME:-}" == *"Raspberry Pi OS"* ]]; then
            FAILOVER_BROWSER="midori"
            return
        fi
    fi

    FAILOVER_BROWSER="falkon"
}

build_calendar_url() {
    local url_without_fragment fragment="" base query entry key
    local -a retained_params=() updated_params=()

    url_without_fragment="$BROWSER_URL"
    if [[ "$url_without_fragment" == *#* ]]; then
        fragment="#${url_without_fragment#*#}"
        url_without_fragment="${url_without_fragment%%#*}"
    fi

    if [[ "$url_without_fragment" == *\?* ]]; then
        base="${url_without_fragment%%\?*}"
        query="${url_without_fragment#*\?}"
        IFS='&' read -r -a retained_params <<< "$query"
    else
        base="$url_without_fragment"
        retained_params=()
    fi

    updated_params=()
    for entry in "${retained_params[@]}"; do
        key="${entry%%=*}"
        case "$key" in
            theme) [[ "$THEME" == "-" ]] && updated_params+=("$entry") ;;
            font) [[ "$FONT" == "-" ]] && updated_params+=("$entry") ;;
            speed) [[ "$SPEED" == "-" ]] && updated_params+=("$entry") ;;
            margins) [[ "$MARGINS" == "-" ]] && updated_params+=("$entry") ;;
            *) [[ -n "$entry" ]] && updated_params+=("$entry") ;;
        esac
    done

    [[ "$THEME" != "-" ]] && updated_params+=("theme=$THEME")
    [[ "$FONT" != "-" ]] && updated_params+=("font=$FONT")
    [[ "$SPEED" != "-" ]] && updated_params+=("speed=$SPEED")
    [[ "$MARGINS" != "-" ]] && updated_params+=("margins=$MARGINS")

    TARGET_URL="$base"
    if (( ${#updated_params[@]} > 0 )); then
        TARGET_URL+="?$(IFS='&'; echo "${updated_params[*]}")"
    fi
    TARGET_URL+="$fragment"
}

persist_calendar_url() {
    local temp_config
    temp_config=$(mktemp "${KIOSK_CONFIG}.tmp.XXXXXX")

    if ! awk -v url="$TARGET_URL" '
        BEGIN { found = 0 }
        /^BROWSER_URL=/ {
            print "BROWSER_URL=\"" url "\""
            found = 1
            next
        }
        { print }
        END {
            if (!found) {
                print "BROWSER_URL=\"" url "\""
            }
        }
    ' "$KIOSK_CONFIG" > "$temp_config"; then
        rm -f "$temp_config"
        echo "Unable to update BROWSER_URL in $KIOSK_CONFIG" >&2
        return 1
    fi

    chown --reference="$KIOSK_CONFIG" "$temp_config"
    chmod --reference="$KIOSK_CONFIG" "$temp_config"
    mv "$temp_config" "$KIOSK_CONFIG"
}

build_calendar_url

resolve_xauthority
detect_failover_browser

# Calendar mode intentionally leaves the kiosk service stopped. Starting the
# browser first would make the wrapper exit and trigger its Restart=always path.
if ! systemctl stop "$KIOSK_SERVICE"; then
    echo "Unable to stop $KIOSK_SERVICE before launching Calendar" >&2
    exit 1
fi

case "$FAILOVER_BROWSER" in
    falkon)
        command -v falkon >/dev/null 2>&1 || {
            echo "Falkon is not installed" >&2
            exit 1
        }
        pkill -u "$KIOSK_USER" -x falkon 2>/dev/null || true
        runuser -u "$KIOSK_USER" -- env "${KIOSK_ENV[@]}" \
            setsid falkon --private-browsing --no-extensions --fullscreen "$TARGET_URL" \
            >>"$FAILOVER_LOG" 2>&1 < /dev/null &
        BROWSER_PROCESS="falkon"
        ;;
    midori)
        command -v midori >/dev/null 2>&1 || {
            echo "Midori is not installed" >&2
            exit 1
        }
        pkill -u "$KIOSK_USER" -x midori 2>/dev/null || true
        runuser -u "$KIOSK_USER" -- env "${KIOSK_ENV[@]}" \
            setsid midori -e SingleWindow -e Fullscreen "$TARGET_URL" \
            >>"$FAILOVER_LOG" 2>&1 < /dev/null &
        BROWSER_PROCESS="midori"
        ;;
esac

# The service is already stopped, so it cannot restart VLC or replace this URL.
for _ in {1..10}; do
    pgrep -u "$KIOSK_USER" -x "$BROWSER_PROCESS" >/dev/null 2>&1 && break
    sleep 0.2
done
if ! pgrep -u "$KIOSK_USER" -x "$BROWSER_PROCESS" >/dev/null 2>&1; then
    echo "$BROWSER_PROCESS did not start; kiosk service remains stopped" >&2
    exit 1
fi

if ! persist_calendar_url; then
    echo "Calendar started, but its settings were not saved" >&2
    exit 1
fi

echo "Calendar settings applied: $QS"
