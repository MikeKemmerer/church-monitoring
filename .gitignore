# Sensitive config (use config.example.json in each directory as templates)
# Real per-host config.json snapshots pulled from deployed hosts (e.g.
# config.liturgystream.json) are also gitignored, but config.example.json
# stays tracked as the template.
client/config.json
client/config.*.json
!client/config.example.json
server/config.json
server/config.*.json
!server/config.example.json

# Dashboard user accounts (password hashes) and session files — never commit
# real ones. server/users.example.json is a schema reference and stays tracked.
server/users.json
!server/users.example.json
server/sessions/

# Certificates and keys
*.pem
*.key
*.crt
*.csr

# Auth
.htpasswd

# Enrollment tokens
tokens/
install-server.sh
install-client.sh
